# AI Day Trading System - Environment Variables
# Copy this to .env and fill in your values

# ===================
# ALPACA CREDENTIALS
# ===================
# Get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
# Use paper-api for paper trading, api for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ===================
# ANTHROPIC AI
# ===================
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# ===================
# TRADING SETTINGS
# ===================
# Set to true to disable actual order execution
DRY_RUN=false

# Debug mode (verbose logging)
DEBUG=false

# ===================
# RISK PARAMETERS
# ===================
# Maximum daily loss (as decimal, e.g., 0.02 = 2%)
PORTFOLIO_MAX_DAILY_LOSS=0.02

# Maximum weekly loss
PORTFOLIO_MAX_WEEKLY_LOSS=0.06

# Maximum positions at once
PORTFOLIO_MAX_POSITIONS=20

# Maximum portfolio heat (total risk exposure)
PORTFOLIO_MAX_PORTFOLIO_HEAT=0.05

# Risk per trade (as decimal)
SIZING_RISK_PER_TRADE=0.01

# ===================
# AI SETTINGS
# ===================
# Confidence threshold to trigger AI review (0-1)
AI_CONFIDENCE_THRESHOLD=0.80

# Enable web search for real-time news
AI_ENABLE_WEB_SEARCH=true

# ===================
# TRADING HOURS
# ===================
# Enable extended hours trading (pre-market and after-hours)
HOURS_EXTENDED_HOURS_ENABLED=true

# ===================
# DATABASE
# ===================
# SQLite database path
DB_URL=sqlite+aiosqlite:///storage/trades.db

# ===================
# LOGGING
# ===================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json or console
LOG_FORMAT=console

# Log file path (optional)
LOG_FILE_PATH=logs/trader.log
